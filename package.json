{
  "name": "leadrescue-ai",
  "version": "0.1.0",
  "private": true,
  "description": "Self-healing lead operations platform: webhook ingestion, CRM sync, remediation, reconciliation and AI incident analysis.",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@10.28.2",
  "scripts": {
    "setup:env": "tsx scripts/setup-env.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "pnpm typecheck && pnpm lint && pnpm test",
    "dev:mastra": "mastra dev --dir src/mastra",
    "build:mastra": "mastra build --dir src/mastra",
    "ollama:smoke": "tsx scripts/ollama-smoke.ts",
    "test:ollama": "RUN_OLLAMA_TESTS=1 vitest run tests/integration/*.ollama.test.ts",
    "sim": "tsx src/simulators/main.ts",
    "seed": "tsx scripts/seed.ts"
  },
  "dependencies": {
    "@hono/node-server": "1.19.18",
    "@mastra/core": "1.81.0",
    "@mastra/libsql": "1.28.0",
    "@mastra/loggers": "1.3.10",
    "@mastra/observability": "1.23.0",
    "better-sqlite3": "13.0.3",
    "hono": "4.13.16",
    "zod": "4.6.7"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild"
    ],
    "patchedDependencies": {
      "@mastra/core@1.81.0": "patches/@mastra__core@1.81.0.patch"
    }
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "22.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "concurrently": "10.0.6",
    "eslint": "10.14.0",
    "mastra": "1.37.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
