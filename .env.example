# LeadRescue AI — environment template.
# `pnpm setup:env` copies this file to .env and fills every __GENERATE__ value with a random secret.

APP_ENV=development            # development | test | demo | production
LOG_LEVEL=info
LOG_FORMAT=pretty              # pretty | json

# All databases live under DATA_DIR (resolved from the repository root).
DATA_DIR=./data
APP_DB_FILE=leadrescue.db      # application state (better-sqlite3)
MASTRA_DB_FILE=mastra.db       # Mastra runtime storage: workflow snapshots, traces, schedules (LibSQL)
SIMULATOR_DB_FILE=simulators.db

APP_PUBLIC_URL=http://localhost:4111
STUDIO_URL=http://localhost:4111
SIMULATOR_PORT=4200
SIMULATOR_BASE_URL=http://localhost:4200

# Secrets (generated locally; never commit .env).
ADMIN_API_TOKEN=__GENERATE__
SIMULATOR_ADMIN_TOKEN=__GENERATE__
CREDENTIALS_ENCRYPTION_KEY=__GENERATE_KEY__

# Local inference. No cloud models are used.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_TIMEOUT_MS=90000
AI_ENABLED=true
AI_ASSESS_RECOVERED=true

# Durable job worker (runs inside the Mastra server process; see docs/architecture.md).
WORKER_ENABLED=true
WORKER_CONCURRENCY=4
WORKER_POLL_MS=500
JOB_LEASE_MS=30000

# Delivery reliability policy.
HTTP_TIMEOUT_MS=5000
RETRY_MAX_ATTEMPTS=5
RETRY_BASE_DELAY_MS=2000
RETRY_MAX_DELAY_MS=60000
DELIVERY_DEADLINE_MS=1800000

# Source reconciliation.
RECONCILE_CRON=*/5 * * * *
RECONCILE_LOOKBACK_MS=900000
RECONCILE_PAGE_SIZE=25
